FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ShedBuilder.sln .
COPY src/ShedBuilder.Api/ShedBuilder.Api.csproj src/ShedBuilder.Api/
RUN dotnet restore src/ShedBuilder.Api/ShedBuilder.Api.csproj
COPY src/ShedBuilder.Api/ src/ShedBuilder.Api/
RUN dotnet publish src/ShedBuilder.Api/ShedBuilder.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .

RUN addgroup --gid 1001 appgroup && \
    adduser --uid 1001 --ingroup appgroup --disabled-password --gecos "" appuser
USER appuser

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "ShedBuilder.Api.dll"]
